# ──────────────────────────────────────────────────────────────────────────────
# Supabase — Prisma connection strings
# Trouve ces valeurs dans : Supabase Dashboard → Settings → Database
# ──────────────────────────────────────────────────────────────────────────────

# Connexion pooler (Transaction mode, pgBouncer) — utilisée par Prisma Client au runtime.
# Host   : aws-0-[region].pooler.supabase.com
# Port   : 6543
# User   : postgres.[project-ref]   ← avec le project-ref dans le nom d'utilisateur
# Source : Dashboard → Settings → Database → "Transaction" connection string
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connexion directe — utilisée uniquement par Prisma CLI (migrate / db push / db seed).
# Host   : db.[project-ref].supabase.co   ← host différent du pooler
# Port   : 5432
# User   : postgres                        ← sans project-ref dans le nom d'utilisateur
# Source : Dashboard → Settings → Database → "Direct" connection string
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"
