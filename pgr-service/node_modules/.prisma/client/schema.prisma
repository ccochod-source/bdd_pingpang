// PGR v1 — Prisma schema for Supabase (PostgreSQL)
//
// Conventions:
//   - All primary keys: UUID via gen_random_uuid()
//   - All timestamps: timestamptz(6) for timezone-aware precision
//   - user_id in players: nullable, reserved for future Supabase Auth RLS
//   - No RLS policies here — add them in Supabase dashboard when ready

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum PgrDataSource {
  FFTT
  WTT
  ITTF
  TTR
  RANKEDIN
  RFETM
  FITET
  CTTA
  JTTA
  KTTF
  PING_PANG
  QUESTIONNAIRE
  MANUAL
}

enum PgrConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

enum PgrValidationStatus {
  PENDING
  CONFIRMED
  DISPUTED
  REJECTED
}

enum PgrConfidenceStatus {
  UNRATED
  PROVISIONAL
  CALIBRATING
  STABLE
}

enum PgrImportStatus {
  PENDING
  DONE
  FAILED
}

enum PgrSnapshotTrigger {
  INITIALIZATION
  MATCH_BATCH
  WEEKLY
  MANUAL
  IMPORT_RECALCULATION
}

// ── source_imports ─────────────────────────────────────────────────────────
// Tracks every external data import for full traceability.

model SourceImport {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source        PgrDataSource
  imported_at   DateTime        @db.Timestamptz(6)
  file_name     String?
  endpoint_url  String?
  record_count  Int?
  status        PgrImportStatus @default(PENDING)
  error_message String?
  created_at    DateTime        @default(now()) @db.Timestamptz(6)

  external_rankings ExternalRanking[]
  matches           Match[]

  @@map("pgr_source_imports")
}

// ── clubs ──────────────────────────────────────────────────────────────────

model Club {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  country_code String?        @db.Char(2)
  city         String?
  source       PgrDataSource?
  external_id  String?
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @updatedAt @db.Timestamptz(6)

  players Player[]

  @@map("pgr_clubs")
}

// ── competitions ───────────────────────────────────────────────────────────

model Competition {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  type         String? // e.g. WTT_MAJOR, WTT_CONTENDER, NATIONAL, REGIONAL, LEAGUE
  country_code String?        @db.Char(2)
  start_date   DateTime?      @db.Date
  end_date     DateTime?      @db.Date
  source       PgrDataSource?
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @updatedAt @db.Timestamptz(6)

  matches Match[]

  @@map("pgr_competitions")
}

// ── players ────────────────────────────────────────────────────────────────

model Player {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Reserved for future Supabase Auth link (auth.uid()).
  // Add RLS policy: USING (user_id = auth.uid()) when ready.
  user_id      String?  @db.Uuid
  first_name   String
  last_name    String
  display_name String
  country_code String?  @db.Char(2)
  birth_year   Int? // public only — never store full DOB
  gender       String? // M / F / X
  category     String? // SENIOR / JUNIOR / CADET / VETERAN / PARA
  club_id      String?  @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)

  club              Club?              @relation(fields: [club_id], references: [id])
  external_ids      PlayerExternalId[]
  external_rankings ExternalRanking[]
  pgr_snapshots     PgrSnapshot[]
  matches_as_a      Match[]            @relation("MatchPlayerA")
  matches_as_b      Match[]            @relation("MatchPlayerB")
  matches_won       Match[]            @relation("MatchWinner")

  @@index([user_id])
  @@index([country_code])
  @@map("pgr_players")
}

// ── player_external_ids ────────────────────────────────────────────────────
// One row per (player, source) pair.
// Unique constraint prevents duplicate external IDs per source.

model PlayerExternalId {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_id    String        @db.Uuid
  source       PgrDataSource
  external_id  String
  external_url String?
  created_at   DateTime      @default(now()) @db.Timestamptz(6)

  player Player @relation(fields: [player_id], references: [id], onDelete: Cascade)

  @@unique([source, external_id])
  @@index([player_id])
  @@map("pgr_player_external_ids")
}

// ── external_rankings ─────────────────────────────────────────────────────
// Stores one row per (player, source, date) snapshot of an official ranking.
// Historical rows are kept for calibration and audit.

model ExternalRanking {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_id        String             @db.Uuid
  source           PgrDataSource
  ranking_value    Float? // raw points/rating in the source's scale
  rank             Int? // position in the source ranking
  ranked_at        DateTime           @db.Date
  confidence_level PgrConfidenceLevel
  import_id        String?            @db.Uuid
  created_at       DateTime           @default(now()) @db.Timestamptz(6)

  player Player        @relation(fields: [player_id], references: [id], onDelete: Cascade)
  import SourceImport? @relation(fields: [import_id], references: [id])

  @@index([player_id, ranked_at])
  @@index([source, ranked_at])
  @@map("pgr_external_rankings")
}

// ── matches ────────────────────────────────────────────────────────────────
// A match between two players. score_a/score_b = sets won.
// sets_detail = [[11,8],[9,11],...] — JSON array of per-set scores.

model Match {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_a_id       String              @db.Uuid
  player_b_id       String              @db.Uuid
  winner_id         String?             @db.Uuid
  score_a           Int? // sets won by player_a
  score_b           Int? // sets won by player_b
  sets_detail       Json? // [[pa_pts, pb_pts], ...] per set
  played_at         DateTime            @db.Timestamptz(6)
  competition_id    String?             @db.Uuid
  source            PgrDataSource
  import_id         String?             @db.Uuid
  validation_status PgrValidationStatus @default(PENDING)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @updatedAt @db.Timestamptz(6)

  player_a    Player        @relation("MatchPlayerA", fields: [player_a_id], references: [id])
  player_b    Player        @relation("MatchPlayerB", fields: [player_b_id], references: [id])
  winner      Player?       @relation("MatchWinner", fields: [winner_id], references: [id])
  competition Competition?  @relation(fields: [competition_id], references: [id])
  import      SourceImport? @relation(fields: [import_id], references: [id])

  @@index([player_a_id, played_at])
  @@index([player_b_id, played_at])
  @@index([played_at])
  @@index([validation_status])
  @@map("pgr_matches")
}

// ── pgr_snapshots ──────────────────────────────────────────────────────────
// Immutable history of PGR states. One row is created after each rating
// period recalculation or manual trigger. Never updated in-place.
// The latest snapshot per player is their current PGR.

model PgrSnapshot {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_id             String              @db.Uuid
  rating                Float
  rating_deviation      Float
  volatility            Float
  match_count           Int                 @default(0)
  confidence_status     PgrConfidenceStatus
  is_provisional        Boolean
  initialization_source PgrDataSource? // source used to seed the first rating
  algorithm_version     String
  snapshot_date         DateTime            @db.Timestamptz(6)
  trigger               PgrSnapshotTrigger
  created_at            DateTime            @default(now()) @db.Timestamptz(6)

  player Player @relation(fields: [player_id], references: [id], onDelete: Cascade)

  @@index([player_id, snapshot_date])
  @@index([snapshot_date])
  @@map("pgr_snapshots")
}
